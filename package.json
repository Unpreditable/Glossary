{
  "name": "glossary",
  "version": "1.0.0",
  "description": "Highlights glossary terms in notes and shows definitions on hover",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && npm run lint && node esbuild.config.mjs production",
    "test": "jest --no-coverage",
    "test:e2e": "npm run build && node ../ObsidianE2EHarness/bin/obsidian-e2e.mjs",
    "test:all": "npm run build && node ../ObsidianE2EHarness/bin/obsidian-test-all.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@codemirror/language": "^6.12.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.40.0",
    "@eslint/js": "^9.39.4",
    "@lezer/common": "^1.5.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "esbuild": "^0.27.4",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "obsidian": "^1.12.3",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1"
  },
  "license": "GPL-3.0-only"
}
